# ---------------------------------------------------------------------------
# SafeScholar AI Gateway — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your API keys.
# NEVER commit `.env.local`.

# === AI Providers (at least one) ===========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# === Provider routing (optional — defaults shown) =========================
AI_LESSON_PROVIDER=openai
AI_LESSON_MODEL=gpt-4o
AI_QUIZ_PROVIDER=openai
AI_QUIZ_MODEL=gpt-4o-mini
AI_FLASHCARD_PROVIDER=openai
AI_FLASHCARD_MODEL=gpt-4o-mini

# === Scrape providers ======================================================
SCRAPE_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
JINA_API_KEY=
SCRAPERAPI_API_KEY=

# === Translate providers ===================================================
TRANSLATE_PROVIDER=deepl
DEEPL_API_KEY=
GOOGLE_API_KEY=
LIBRETRANSLATE_URL=

# === Infrastructure ========================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === NextAuth ==============================================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
